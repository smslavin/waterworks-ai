{
  "title": "WTP Process Data",
  "uid": "wtp-process",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "5s",
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "graphTooltip": 1,
  "tags": ["waterworks", "process"],

  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": { "type": "influxdb", "uid": "waterworks-influx" },
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "lineWidth": 2,
        "name": "Fault Events",
        "target": {
          "datasource": { "type": "influxdb", "uid": "waterworks-influx" },
          "query": "from(bucket: \"waterworks\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"wtp_fault_events\")\n  |> filter(fn: (r) => r._field == \"mode\")\n  |> keep(columns: [\"_time\", \"_value\", \"target\"])",
          "refId": "Anno"
        },
        "titleFormat": "Fault: ${target}",
        "textFormat": "${_value}"
      },
      {
        "datasource": { "type": "influxdb", "uid": "waterworks-influx" },
        "enable": true,
        "hide": false,
        "iconColor": "#6495ED",
        "lineWidth": 1,
        "name": "AI Queries",
        "target": {
          "datasource": { "type": "influxdb", "uid": "waterworks-influx" },
          "query": "from(bucket: \"waterworks\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"ai_metrics\")\n  |> filter(fn: (r) => r._field == \"input_tokens\")\n  |> keep(columns: [\"_time\", \"model\"])",
          "refId": "AnnoAI"
        },
        "titleFormat": "AI Query",
        "textFormat": "${model}"
      }
    ]
  },

  "panels": [

    {
      "id": 1,
      "type": "stat",
      "title": "Active Pumps",
      "datasource": { "type": "influxdb", "uid": "waterworks-influx" },
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 3 },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"waterworks\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"wtp_process\")\n  |> filter(fn: (r) => r.type == \"Pump\")\n  |> filter(fn: (r) => r.attribute == \"Running\")\n  |> filter(fn: (r) => r._field == \"value\")\n  |> last()\n  |> group()\n  |> sum()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "green",  "value": 2 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["last"], "fields": "", "values": false },
        "textMode": "auto"
      }
    },

    {
      "id": 2,
      "type": "stat",
      "title": "Inlet Flow (L/min)",
      "datasource": { "type": "influxdb", "uid": "waterworks-influx" },
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 3 },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"waterworks\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"wtp_process\")\n  |> filter(fn: (r) => r.instance == \"RawWater_01\")\n  |> filter(fn: (r) => r.attribute == \"Flow\")\n  |> filter(fn: (r) => r._field == \"value\")\n  |> last()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "green",  "value": 150 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["last"], "fields": "", "values": false },
        "textMode": "auto"
      }
    },

    {
      "id": 3,
      "type": "stat",
      "title": "Finished Water pH",
      "datasource": { "type": "influxdb", "uid": "waterworks-influx" },
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 3 },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"waterworks\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"wtp_process\")\n  |> filter(fn: (r) => r.instance == \"FinishedWater_01\")\n  |> filter(fn: (r) => r.attribute == \"pH\")\n  |> filter(fn: (r) => r._field == \"value\")\n  |> last()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",   "value": null },
              { "color": "green", "value": 6.5 },
              { "color": "red",   "value": 8.5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["last"], "fields": "", "values": false },
        "textMode": "auto"
      }
    },

    {
      "id": 4,
      "type": "stat",
      "title": "Turbidity (NTU)",
      "datasource": { "type": "influxdb", "uid": "waterworks-influx" },
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 3 },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"waterworks\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"wtp_process\")\n  |> filter(fn: (r) => r.instance == \"FinishedWater_01\")\n  |> filter(fn: (r) => r.attribute == \"Turbidity\")\n  |> filter(fn: (r) => r._field == \"value\")\n  |> last()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 3,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red",    "value": 1.0 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["last"], "fields": "", "values": false },
        "textMode": "auto"
      }
    },

    {
      "id": 5,
      "type": "timeseries",
      "title": "Pump Flow Rates (L/min)",
      "datasource": { "type": "influxdb", "uid": "waterworks-influx" },
      "gridPos": { "x": 0, "y": 3, "w": 16, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"waterworks\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"wtp_process\")\n  |> filter(fn: (r) => r.type == \"Pump\")\n  |> filter(fn: (r) => r.attribute == \"Flow\")\n  |> filter(fn: (r) => r._field == \"value\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> yield(name: \"flow\")"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "displayName": "${__field.labels.instance}",
          "custom": {
            "lineWidth": 1.5,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["last"] },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    },

    {
      "id": 6,
      "type": "timeseries",
      "title": "Tank Levels (%)",
      "datasource": { "type": "influxdb", "uid": "waterworks-influx" },
      "gridPos": { "x": 16, "y": 3, "w": 8, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"waterworks\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"wtp_process\")\n  |> filter(fn: (r) => r.type == \"StorageTank\" or r.type == \"Clarifier\")\n  |> filter(fn: (r) => r.attribute == \"Level\")\n  |> filter(fn: (r) => r._field == \"value\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> yield(name: \"level\")"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "displayName": "${__field.labels.instance}",
          "custom": {
            "lineWidth": 1.5,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["last"] },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    },

    {
      "id": 7,
      "type": "timeseries",
      "title": "Finished Water pH",
      "datasource": { "type": "influxdb", "uid": "waterworks-influx" },
      "gridPos": { "x": 0, "y": 11, "w": 8, "h": 7 },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"waterworks\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"wtp_process\")\n  |> filter(fn: (r) => r.instance == \"FinishedWater_01\")\n  |> filter(fn: (r) => r.attribute == \"pH\")\n  |> filter(fn: (r) => r._field == \"value\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> yield(name: \"pH\")"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "displayName": "pH",
          "min": 6.0,
          "max": 9.0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": { "mode": "line+area" }
          },
          "color": { "fixedColor": "#5794F2", "mode": "fixed" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",   "value": null },
              { "color": "green", "value": 6.5 },
              { "color": "red",   "value": 8.5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["last", "mean"] },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },

    {
      "id": 8,
      "type": "timeseries",
      "title": "Turbidity (NTU)",
      "datasource": { "type": "influxdb", "uid": "waterworks-influx" },
      "gridPos": { "x": 8, "y": 11, "w": 8, "h": 7 },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"waterworks\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"wtp_process\")\n  |> filter(fn: (r) => r.attribute == \"Turbidity\")\n  |> filter(fn: (r) => r._field == \"value\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> yield(name: \"turbidity\")"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "displayName": "${__field.labels.instance}",
          "min": 0,
          "custom": {
            "lineWidth": 1.5,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": { "mode": "line" }
          },
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 1.0 },
              { "color": "red",    "value": 4.0 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["last", "max"] },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    },

    {
      "id": 9,
      "type": "timeseries",
      "title": "UV Intensity & Chemical Dosing",
      "datasource": { "type": "influxdb", "uid": "waterworks-influx" },
      "gridPos": { "x": 16, "y": 11, "w": 8, "h": 7 },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"waterworks\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"wtp_process\")\n  |> filter(fn: (r) => r.type == \"UV\")\n  |> filter(fn: (r) => r.attribute == \"Intensity\")\n  |> filter(fn: (r) => r._field == \"value\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> yield(name: \"uv_intensity\")"
        },
        {
          "refId": "B",
          "query": "from(bucket: \"waterworks\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"wtp_process\")\n  |> filter(fn: (r) => r.type == \"Dosing\")\n  |> filter(fn: (r) => r.attribute == \"FlowRate\")\n  |> filter(fn: (r) => r._field == \"value\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> yield(name: \"dosing_flow\")"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "displayName": "${__field.labels.instance}",
          "custom": {
            "lineWidth": 1.5,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          {
            "matcher": { "id": "byFrameRefID", "options": "B" },
            "properties": [
              { "id": "unit", "value": "short" },
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "custom.axisLabel", "value": "Dosing (L/h)" }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["last"] },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    }

  ]
}
