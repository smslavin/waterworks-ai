# Copy to .env and adjust as needed.
# Default values match the docker-compose.yml defaults — fine for local dev.

# ── Docker Compose host ports (mosquitto/influxdb/grafana) ────────────────────
# Only needed to run a second stack (e.g. M10 multi-plant) alongside this one —
# override in that checkout's own .env to avoid host port collisions.
# MOSQUITTO_PORT=1883
# INFLUXDB_HOST_PORT=8086
# GRAFANA_PORT=3000

# ── Multi-plant identity (M10) ─────────────────────────────────────────────────
# Tags every session_summaries/action_events row written by this process group.
# Matches topology.yaml's facility.site_id by convention, but read independently
# from a plain env var (not parsed out of topology.yaml) since each plant is a
# fully independent process group — see M10 Phase 0.
SITE_ID=wtp

# ── InfluxDB ─────────────────────────────────────────────────────────────────
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=waterworks-admin
INFLUXDB_ORG=waterworks
INFLUXDB_BUCKET=waterworks
# Token is set once during first-run init. Change before any network exposure.
INFLUXDB_TOKEN=waterworks-dev-token

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=waterworks

# ── Simulator ─────────────────────────────────────────────────────────────────
# Optional: override default topology.yaml path
# TOPOLOGY_FILE=../topology.yaml
# Optional: override default simulator.yaml path (generation mechanics: lo/hi/
# step/initial/flip, per-instance overrides — split from topology.yaml in the
# fieldworks-core port so topology.yaml stays a clean, spec-compliant example)
# SIMULATOR_CONFIG_FILE=../simulator.yaml
MQTT_BROKER_URL=localhost
MQTT_BROKER_PORT=1883
OPCUA_PORT=4840
CONTROL_PORT=8090
PUBLISH_INTERVAL=2.0
# The simulator/bridge/monitor's own topic prefix (published/subscribed as
# PLANT_TOPIC_ROOT/<Type>/<Instance>/<Attribute>). Not the same thing as
# mqtt-mcp's MQTT_TOPIC_ROOT below — that one is the adapter's own background
# subscription wildcard, unrelated on purpose so the two don't collide.
PLANT_TOPIC_ROOT=Plant/WTP

# ── MCP servers ───────────────────────────────────────────────────────────────
# mqtt-mcp
MQTT_TOPIC_ROOT=#
# FASTMCP_PORT set per server: mqtt-mcp=8001, opcua-mcp=8002, influxdb-mcp=8003

# ── Memory MCP (:8006) ────────────────────────────────────────────────────────
MEMORY_MCP_PORT=8006
LADYBUG_DB_PATH=../data/ladybugdb/fieldworks.db
DUCKDB_PATH=../data/duckdb/analytical.duckdb
SPECIALIST_MEMORY_DIR=../data/specialist-memory
DUCKDB_SYNC_INTERVAL=3600

# ── Topology Builder (:8007) ──────────────────────────────────────────────────
TOPOLOGY_BUILDER_PORT=8007
MEMORY_MCP_URL=http://localhost:8006

# ── Chat UI ───────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OLLAMA_URL=http://127.0.0.1:11434

# ── Reactive mode -----------──────────────────────────────────────────────────
REACTIVE_ENABLED=0                          # Set 1 to enable proactive monitoring
REACTIVE_COOLDOWN=60                        # Seconds cooldown per instance after a diagnostic
REACTIVE_MIN_DURATION=30                    # Seconds out-of-range before firing to Deadband
REACTIVE_MODEL=claude-haiku-4-5-20251001

# ── Audit log encryption ──────────────────────────────────────────────────────
# Generate: python3 -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# If unset, log is written as plaintext (dev mode only — set this in production).
AUDIT_KEY=
# Optional: override default log path (default: chat-ui/audit.jsonl)
# AUDIT_LOG_PATH=/var/log/waterworks/audit.jsonl
